# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API).
#
# These end up in the built JavaScript bundle. That is expected: the anon key
# is a public key and row-level security is the actual access control. Do not
# put the service_role key here, ever.
#
# Leave both blank and the site still runs -- schedule, travel, route and
# gallery pages are entirely static. Only the packing board and kit need these.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
